[sub_resource type="Resource" id="gu_sternpfeil_klein"]
script = ExtResource("1_5r2ml")
id = &"sternpfeil_klein"
display_name = "Sternenpfeil-Gu"
family = &"stern"
description = "Drei kleine Sternenpfeile, die ihr Ziel selbst finden."
lore = "Das billigste Fernkampf-Gu der Gu-Welt. Jeder Anfänger hat eines."

[sub_resource type="Resource" id="gu_sternpfeil"]
script = ExtResource("1_5r2ml")
id = &"sternpfeil"
display_name = "Sternpfeil-Gu"
family = &"stern"
rank = 2
rank_gift = "Fünf Pfeile."
description = "Fünf Pfeile aus verdichtetem Sternenlicht."
lore = "Verschießt Pfeile aus verdichtetem Sternenlicht."
gifts = {
"count_add": 2.0
}

[sub_resource type="Resource" id="gu_gluehwuermchen"]
