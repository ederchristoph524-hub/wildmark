"t": "teleport"
}, {
"t": "delay",
"then": [{
"at": "target",
"color": "#fff2b0",
"distance": 9.0,
"mult": 2.5,
"radius": 3.5,
"t": "circle",
"tags": ["stern", "wucht"]
}],
"time": 0.8
}],
"step": {
"stacks": 1.0,
"status": "schwaeche"
}
}

[resource]
