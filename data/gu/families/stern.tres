"mult": 2.5,
"radius": 3.0,
"t": "circle",
"tags": ["stern", "wucht"]
}],
"time": 0.8
}],
"step": {
"stacks": 1.0,
"status": "schwaeche"
}
}

[sub_resource type="Resource" id="gu_sternentor"]
script = ExtResource("1_5r2ml")
id = &"sternentor"
