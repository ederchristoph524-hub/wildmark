display_name = "Kleiner-Tausch-Gu"
family = &"tausch"
description = "Tauscht blitzschnell den Platz mit einem Gegner bis 10 m und betäubt ihn kurz."

[sub_resource type="Resource" id="gu_sprungtor"]
