[sub_resource type="Resource" id="gu_hartes_qi"]
script = ExtResource("1_msaaj")
id = &"hartes_qi"
display_name = "Hartes-Qi-Gu"
family = &"qischirm"
description = "Eine unsichtbare Hülle aus verdichtetem Qi: 5 s nehmen du und Verbündete darin 20 % weniger Schaden, Gegner werden weggedrückt."

[sub_resource type="Resource" id="gu_kraft_qi"]
