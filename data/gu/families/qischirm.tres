display_name = "Kraft-Qi-Gu"
family = &"qischirm"
rank = 2
rank_gift = "25 % Schutz, stärkerer Stoß."
description = "Qi verdichtet sich wie Muskeln: die Hülle schützt stärker und stößt härter."
gifts = {
"step": {
"ally_reduction": 0.25,
"knockback": 0.6
}
}

