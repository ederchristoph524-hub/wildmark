[sub_resource type="Resource" id="gu_irrweg"]
script = ExtResource("1_de1pc")
id = &"irrweg"
display_name = "Irrweg-Gu"
family = &"labyrinth"
description = "Ein Labyrinth aus Nebel am Ziel: Gegner darin irren geblendet und langsam umher."

[sub_resource type="Resource" id="gu_drei_wege"]
script = ExtResource("1_de1pc")
id = &"drei_wege"
display_name = "Drei-Wege-Irrgarten-Gu"
family = &"labyrinth"
rank = 2
rank_gift = "Radius 3,7, Schwäche."
description = "Drei Wege, keiner führt hinaus: die Verirrten werden schwach."
gifts = {
"radius_add": 0.5,
"step": {
"stacks": 1.0,
"status": "schwaeche"
}
}

[sub_resource type="Resource" id="gu_schneekristall"]
script = ExtResource("1_de1pc")
id = &"schneekristall"
display_name = "Schneekristall-Formation-Gu"
family = &"labyrinth"
rank = 3
rank_gift = "Frost je Takt, am Ende 1,5 s eingefroren."
description = "Eiskristalle wachsen zwischen den Wänden; wenn die Formation zerfällt, friert alles darin ein."
gifts = {
"step": {
"end": [{
"color": "#bfeaff",
"freeze": 1.5,
"mult": 0.6,
"radius": 3.7,
"t": "circle",
"tags": ["eis"]
}],
"stacks": 1.0,
"status": "frost",
"tags": ["seele", "eis"]
}
}

[sub_resource type="Resource" id="gu_sechs_richtungen"]
script = ExtResource("1_de1pc")
id = &"sechs_richtungen"
