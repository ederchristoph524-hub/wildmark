"freeze": 1.5,
"mult": 0.8,
"radius": 4.7,
"t": "circle",
"tags": ["eis"]
}],
"pull": 1.0,
"stacks": 1.0,
"status": "frost",
"tags": ["seele", "eis"]
},
"time_add": 2.0
}

[sub_resource type="Resource" id="gu_neun_palaeste"]
script = ExtResource("1_de1pc")
id = &"neun_palaeste"
display_name = "Neun-Paläste-Formation-Gu"
family = &"labyrinth"
rank = 5
rank_gift = "Zieht stärker, am Ende Einsturz (2,5×, betäubt 1,5 s)."
description = "Neun Paläste stürzen zusammen: wer im Irrgarten gefangen war, wird zermalmt."
gifts = {
"radius_add": 0.5,
"step": {
"end": [{
"color": "#bfeaff",
"freeze": 1.0,
"mult": 0.5,
"radius": 5.2,
"t": "circle",
"tags": ["eis"]
}, {
"t": "delay",
"then": [{
"color": "#d8c070",
"knockback": 1.0,
"mult": 2.5,
"radius": 5.2,
"stun": 1.5,
"t": "circle",
"tags": ["erde", "wucht"]
}],
"time": 1.0
}],
"pull": 1.4,
"stacks": 1.0,
"status": "frost",
"tags": ["seele", "eis"]
}
}

[resource]
